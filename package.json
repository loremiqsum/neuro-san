{
  "name": "ppl-workout-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Push/Pull/Legs workout tracker - mobile-first web app",
  "scripts": {
    "dev:server": "cd server && node index.js",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "cd client && npm run build",
    "lint": "cd client && npx eslint src/"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
